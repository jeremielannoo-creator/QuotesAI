# =============================================
# QUOTESAI - Configuration des clés API
# Renommer ce fichier en .env et remplir les valeurs
# =============================================

# --- Google Gemini ---
GEMINI_API_KEY=AIza...

# --- Pexels (vidéos background) ---
PEXELS_API_KEY=...

# --- Cloudinary (hébergement temporaire pour Instagram) ---
# Créer un compte gratuit sur cloudinary.com
CLOUDINARY_CLOUD_NAME=mon_cloud
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# --- Instagram Graph API ---
# Compte Instagram Creator/Business requis
# Token généré via https://developers.facebook.com/
INSTAGRAM_ACCESS_TOKEN=EAABsb...
INSTAGRAM_USER_ID=17841...

# --- TikTok Content Posting API ---
# Accès via https://developers.tiktok.com/
TIKTOK_ACCESS_TOKEN=act....
TIKTOK_OPEN_ID=...

# --- Page Facebook (partage auto des Reels et des posts photo) ---
FACEBOOK_PAGE_ID=...
FACEBOOK_PAGE_TOKEN=EAA...

# --- Photos du personnage Ava (génération d'images) ---
# Utilise la même clé que GEMINI_API_KEY.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Mention de transparence ajoutée aux posts montrant Ava.
# La vider la retire des légendes — voir docs/STRATEGIE_CONTENU.md.
AI_DISCLOSURE=Ava est un personnage de fiction, ses photos sont générées par IA.

# --- Fonds vidéo text-to-video (optionnel, facturé au clip) ---
# 0 = on n'utilise que la banque locale assets/backgrounds/ + Pexels/Pixabay.
VIDEO_AI_ENABLED=0
VIDEO_AI_MODEL=Wan-AI/Wan2.2-T2V-A14B
HF_TOKEN=hf_...
